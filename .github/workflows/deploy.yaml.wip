

name: Deploy to souta-lab via Cloudflare Pages


on:
  push:


permissions:
  contents: read


jobs:
  build-and-deploy:
    runs-on: ubuntu-latest


    steps:
      - name: Setup repo
        uses: actions/checkout@v3


      - name: Setup Bun
        uses: oven-sh/setup-bun@v1


      - name: Install deps
        run: bun --bun i
      - name: Build on Bun
        run: bun --bun run build
      - name: show dir info
        run: |
          pwd
          ls
      - name: Publish
        uses: cloudflare/wrangler-action@v3
        with:
          apiToken: ${{ secrets.CF_API_TOKEN }}
          accountId: ${{ secrets.CF_ACCOUNT_ID }}
          command: pages deploy dist --project-name=astro-souta-website

